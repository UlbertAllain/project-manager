generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id            String   @id @default(cuid())
  projectName   String
  clientName    String
  projectLead   String   @default("")
  description   String   @default("")
  status        String   @default("NEW")
  priority      String   @default("MEDIUM")
  category      String   @default("WEB")
  techStack     String   @default("[]")
  startDate     String   @default("")
  deadline      String   @default("")
  completedDate String?
  budget        Float    @default(0)
  paidAmount    Float    @default(0)
  totalExpense  Float    @default(0)
  paymentStatus String   @default("UNPAID")
  progress      Int      @default(0)
  notes         String   @default("")
  coverImage    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks        Task[]
  attachments  LinkAttachment[]
  transactions Transaction[]
  comments     Comment[]
  logs         ActivityLog[]
}

model Task {
  id          String  @id @default(cuid())
  title       String
  isCompleted Boolean @default(false)
  order       Int     @default(0)
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model LinkAttachment {
  id        String @id @default(cuid())
  title     String
  url       String
  platform  String @default("Lainnya")
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("link_attachments")
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   // INCOME or EXPENSE
  amount      Float
  description String   @default("")
  date        String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("transactions")
}

model Comment {
  id        String   @id @default(cuid())
  userEmail String
  message   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  message     String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timestamp   DateTime @default(now())
}
